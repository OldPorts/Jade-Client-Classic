{
	"schemaVersion": 1,
	"id": "jade-client",
	"version": "${version}",
	"name": "Jade Client",
	"description": "A performance-focused, EULA-compliant Minecraft client with a clean centered UI, FPS boosts, HUD customization and opt-in cosmetics.",
	"authors": [
		"Jade Client Team"
	],
	"contact": {
		"homepage": "https://jadeclient.example.com",
		"sources": "https://github.com/jadeclient/jade-client"
	},
	"license": "MIT",
	"icon": "assets/jade-client/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.jadeclient.JadeClient"
		],
		"client": [
			"com.jadeclient.JadeClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/jadeclient"
			}
		}
	}
}
